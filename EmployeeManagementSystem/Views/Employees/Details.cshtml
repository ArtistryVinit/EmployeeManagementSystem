        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.EmpNo)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FirstName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FirstName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.MiddleName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MiddleName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.LastName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.LastName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PhoneNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PhoneNumber)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EmailAddress)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.EmailAddress)
        </dd>

        <dt class="col-sm-2">Country</dt>
        <dd class="col-sm-10">
            @(Model.Country?.Name ?? "N/A")
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DateOfBirth)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DateOfBirth)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Address)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Address)
        </dd>
        <dt class="col-sm-2">Department</dt>
        <dd class="col-sm-10">
            @(Model.Department?.Name ?? "N/A")
        </dd>
        <dt class="col-sm-2">Designation</dt>
        <dd class="col-sm-10">
            @(Model.Designation?.Name ?? "N/A")
        </dd>
      @*   <dt class="col-sm-2">Gender</dt>
        <dd class="col-sm-10">
            @(Model.Gender?.Name ?? "N/A")
        </dd> *@

        <dt class="col-sm-4">Employee Photo</dt>
        <dd class="col-sm-8">
            @if (!string.IsNullOrEmpty(Model.Photo))
            {
                <img src="@Url.Content("~/Uploads/EmployeePicture/" + Model.Photo)" class="img-thumbnail" width="150" height="150" alt="Employee Photo" />
            }
            else
            {
                <span>No photo available</span>
            }

        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Edit</a>

@model EmployeeManagementSystem.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Assign User Roles";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Assign User Roles</h3>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-12">
                <form asp-action="AssignRights" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <!-- Role Selection -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="RoleId" class="control-label"></label>
                                <select asp-for="RoleId" class="form-control" asp-items="ViewBag.Roles">
                                    <option value="">-- Select Role --</option>
                                </select>
                                <span asp-validation-for="RoleId" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Task Selection -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="TaskId" class="control-label"></label>
                                <select asp-for="TaskId" class="form-control" asp-items="ViewBag.Tasks">
                                    <option value="">-- Select Task --</option>
                                </select>
                                <span asp-validation-for="TaskId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <div class="form-group mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-plus"></i> Assign Rights
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

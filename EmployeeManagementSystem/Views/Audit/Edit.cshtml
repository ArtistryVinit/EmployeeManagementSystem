@model EmployeeManagementSystem.Models.Audit

@{
    ViewData["Title"] = "Edit Audit Log";
}

<h2>Edit Audit Log</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="TableName" class="control-label"></label>
        <input asp-for="TableName" class="form-control" readonly />
    </div>

    <div class="form-group">
        <label asp-for="UserId" class="control-label"></label>
        <input asp-for="UserId" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="AuditType" class="control-label"></label>
        <input asp-for="AuditType" class="form-control" readonly />
    </div>

   @*  <div class="form-group">
        <label asp-for="CreatedOn" class="control-label"></label>
        <input asp-for="CreatedOn" class="form-control" readonly />
    </div> *@

    <div class="form-group">
        <label asp-for="OldValues" class="control-label"></label>
        <textarea asp-for="OldValues" class="form-control" readonly></textarea>
    </div>

    <div class="form-group">
        <label asp-for="NewValues" class="control-label"></label>
        <textarea asp-for="NewValues" class="form-control"></textarea>
    </div>

    <div class="form-group mt-3">
        <button type="submit" class="btn btn-success">Save Changes</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@model IEnumerable<EmployeeManagementSystem.Models.LeaveApplication>

@{
    ViewData["Title"] = "Leave Applications";
}

<a asp-action="Create" class="btn btn-primary"><i class="fa fa-plus"></i>Add New LeaveApplication</a>

<h2>Leave Applications</h2>
<hr />

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Employee Name</th>
            <th>Leave Type</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Number of Days</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var leave in Model)
        {
            <tr>
                <td>@leave.Employee.FullName</td>
                <td>@leave.LeaveType.Name</td>
                <td>@leave.StartDate.ToString("yyyy-MM-dd")</td>
                <td>@leave.EndDate.ToString("yyyy-MM-dd")</td>
                <td>@leave.NumberOfDays</td>
                <td>@leave.Status.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@leave.Id" class="btn btn-primary btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@leave.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-success">Apply for Leave</a>

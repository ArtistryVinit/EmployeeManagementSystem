@model IEnumerable<EmployeeManagementSystem.Models.LeaveApplication>

@{
    ViewData["Title"] = "Leave Applications";
}

<h2>Leave Applications</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Apply for Leave</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Employee.FullName)</th>
            <th>@Html.DisplayNameFor(model => model.LeaveType.Name)</th>
            <th>@Html.DisplayNameFor(model => model.NumberOfDays)</th>
            <th>@Html.DisplayNameFor(model => model.StartDate)</th>
            <th>@Html.DisplayNameFor(model => model.EndDate)</th>
            <th>@Html.DisplayNameFor(model => model.Status.Name)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@(item.Employee?.FullName ?? "N/A")</td>
            <td>@(item.LeaveType?.Name ?? "N/A")</td>
            <td>@item.NumberOfDays</td>
            <td>@item.StartDate.ToShortDateString()</td>
            <td>@item.EndDate.ToShortDateString()</td>
            <td>@(item.Status?.Name ?? "N/A")</td>
            <td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
                    <a asp-action="ApprovedLeaveApplications" class="btn btn-success">View Approved Leaves</a>
                    <a asp-action="RejectedLeaveApplications" class="btn btn-danger">View Rejected Leaves</a>


                </td>

                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Edit</a>

                        @if (item.StatusId != 2) // Assuming 2 is the "Approved" status
                        {
                        <a asp-action="ApproveLeave" asp-route-id="@item.Id" class="btn btn-success">Approve</a>
                        }

                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
                </td>

                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Edit</a>

                        @if (item.StatusId != 2 && item.StatusId != 3) // Ensure it's not already Approved (2) or Rejected (3)
                        {
                        <a asp-action="ApproveLeave" asp-route-id="@item.Id" class="btn btn-success">Approve</a>
                        <a asp-action="RejectLeave" asp-route-id="@item.Id" class="btn btn-danger">Reject</a>
                        }

                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-secondary">Delete</a>
                </td>


        </tr>
    }
</tbody>

</table>

@model EmployeeManagementSystem.Models.LeaveApplication

@{
	ViewData["Title"] = "Reject Leave Application";
}

<h2>Reject Leave Application</h2>

<h3>Are you sure you want to reject this leave request?</h3>

<div>
	<h4>Leave Application Details</h4>
	<hr />
	<dl class="row">
		<dt class="col-sm-2">Employee</dt>
		<dd class="col-sm-10">@Model.Employee.FullName</dd>

		<dt class="col-sm-2">Leave Type</dt>
		<dd class="col-sm-10">@Model.LeaveType.Name</dd>

		<dt class="col-sm-2">Number of Days</dt>
		<dd class="col-sm-10">@Model.NumberOfDays</dd>

		<dt class="col-sm-2">Start Date</dt>
		<dd class="col-sm-10">@Model.StartDate.ToString("yyyy-MM-dd")</dd>

		<dt class="col-sm-2">End Date</dt>
		<dd class="col-sm-10">@Model.EndDate.ToString("yyyy-MM-dd")</dd>

		<dt class="col-sm-2">Current Status</dt>
		<dd class="col-sm-10">@Model.Status.Name</dd>
	</dl>
</div>

<form asp-action="RejectLeave" method="post">
	<input type="hidden" asp-for="Id" />
	<button type="submit" class="btn btn-danger">Reject</button>
	<a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@model IEnumerable<EmployeeManagementSystem.Models.LeaveApplication>

@{
    ViewData["Title"] = "Rejected Leave Applications";
}

<h2>Rejected Leave Applications</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Employee</th>
            <th>Leave Type</th>
            <th>Number of Days</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Employee.FullName</td>
                <td>@item.LeaveType.Name</td>
                <td>@item.NumberOfDays</td>
                <td>@item.StartDate.ToString("yyyy-MM-dd")</td>
                <td>@item.EndDate.ToString("yyyy-MM-dd")</td>
                <td>@item.Status.Name</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-primary">Back to All Leave Applications</a>
